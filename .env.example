# No key is needed for Meteora or basic EVM discovery.
DATABASE_PATH=./data/scanner.sqlite
API_PORT=3001
SCAN_INTERVAL_SECONDS=60
# Keep every snapshot unless you explicitly choose a positive number of days.
RETENTION_DAYS=0
METEORA_API_URL=https://dlmm.datapi.meteora.ag
METEORA_MIN_TVL=10000
# 0 = all matching pools; page size 1000. Choose a cap to reduce disk use.
METEORA_MAX_POOLS=1000
METEORA_REQUESTS_PER_SECOND=5
GECKO_API_URL=https://api.geckoterminal.com/api/v2
EVM_PAGES=1
GECKO_REQUESTS_PER_MINUTE=20
# Optional V3 subgraphs (may require provider keys in the URL)
BASE_SUBGRAPH_URL=
BSC_SUBGRAPH_URL=
# Optional read-only RPC checks of fee/tick spacing for EVM pools
BASE_RPC_URL=
BSC_RPC_URL=
HTTP_TIMEOUT_MS=15000
HTTP_RETRIES=2
LOG_LEVEL=info
SURGE_MULTIPLIER=3
SURGE_MIN_HOURLY_FEES=10
ALERT_MIN_ACTIVITY=80
ALERT_MAX_RISK=60
ALERT_MIN_FEE_EFFICIENCY=0.001
ALERT_COOLDOWN_MINUTES=60
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
APP_URL=http://localhost:3000

# Sprint 2: read-only active-liquidity enrichment. Empty RPC URLs use public defaults.
SOLANA_RPC_URL=
ACTIVE_LIQUIDITY_ENABLED=true
ACTIVE_LIQUIDITY_METEORA_LIMIT=40
ACTIVE_LIQUIDITY_EVM_LIMIT=20
ACTIVE_LIQUIDITY_MAX_AGE_SECONDS=120
ACTIVE_LIQUIDITY_PRICE_MAX_AGE_SECONDS=180
ACTIVE_LIQUIDITY_MAX_PRICE_DIVERGENCE=0.1

# Sprint 3: timestamped prices, measured EVM fees and bounded depth.
PRICE_API_URL=https://coins.llama.fi
PRICE_POOL_LIMIT=1000
PRICE_FALLBACK_LIMIT=20
PRICE_CONSENSUS_HIGH_DEVIATION_PCT=1
PRICE_CONSENSUS_MEDIUM_DEVIATION_PCT=15
PRICE_HIGH_AGE_SECONDS=120
PRICE_MEDIUM_AGE_SECONDS=600
PRICE_STABLECOIN_MEDIUM_AGE_SECONDS=900
PRICE_LOW_AGE_SECONDS=1800
PRICE_DISAGREEMENT=0.1
PRICE_UNAVAILABLE_DISAGREEMENT=0.3
FEE_EVM_LIMIT=3
FEE_MAX_BLOCKS_PER_SCAN=300
BSC_FEE_MAX_BLOCKS_PER_SCAN=900
FEE_CONFIRMATIONS=12
FEE_LOG_BLOCK_CHUNK=100
DEPTH_METEORA_LIMIT=5
DEPTH_EVM_LIMIT=5
DEPTH_REFRESH_SECONDS=600
TOKEN_METADATA_REFRESH_SECONDS=21600
DEPTH_MAX_ARRAYS=32
DEPTH_MAX_TICK_WORDS=24
DEPTH_MAX_INITIALIZED_TICKS=512
# Optional public RPC overrides for fee logs and tick-depth reads.
BSC_FEE_RPC_URL=
BASE_DEPTH_RPC_URL=

# Sprint 4: bounded background research work. Public RPCs can rate-limit fee logs.
BACKGROUND_INTERVAL_SECONDS=30
BACKFILL_POOLS_PER_CYCLE=2
BACKFILL_MAX_BLOCKS_PER_CYCLE=300
BACKFILL_MAX_RETRIES=5
PRIORITY_TIER1_VOLUME_1H=50000
PRIORITY_TIER2_VOLUME_1H=5000
PRIORITY_TIER2_TVL=100000
SIGNAL_FEE_EFFICIENCY=0.001
SIGNAL_VOLUME_DEPTH=1
SIGNAL_MIN_ACTIVITY=70
SIGNAL_MAX_RISK=60
SIGNAL_BREAKOUT_PCT=5
SIGNAL_COLLAPSE_PCT=20
ACTIVITY_PERSISTENCE_FRACTION=0.5
OUTCOME_MAX_GAP_SECONDS=240
